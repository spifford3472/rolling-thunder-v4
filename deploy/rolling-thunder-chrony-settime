#!/bin/sh
set -eu

MIN_EPOCH=1577836800
MAX_EPOCH=4102444800
CHRONYC=/usr/bin/chronyc
DATE=/usr/bin/date

fail() {
    printf '%s\n' "ERROR: $*" >&2
    exit 1
}

[ "$(id -u)" -eq 0 ] || fail "helper must run as root"
[ "$#" -eq 1 ] || fail "exactly one UTC epoch argument is required"

case "$1" in
    ''|*[!0-9]*) fail "UTC epoch must contain decimal digits only" ;;
esac

EPOCH="$1"
[ "$EPOCH" -ge "$MIN_EPOCH" ] || fail "UTC epoch is before 2020-01-01"
[ "$EPOCH" -lt "$MAX_EPOCH" ] || fail "UTC epoch is not before 2100-01-01"
[ -x "$CHRONYC" ] || fail "chronyc is unavailable at $CHRONYC"
[ -x "$DATE" ] || fail "date is unavailable at $DATE"

TARGET="$($DATE -u -d "@$EPOCH" '+%Y-%m-%d %H:%M:%S')" \
    || fail "UTC epoch could not be converted"

restore_ntp_sampling() {
    "$CHRONYC" -n manual off >/dev/null 2>&1 || true
    "$CHRONYC" -n online >/dev/null 2>&1 || true
    "$CHRONYC" -n burst 2/4 >/dev/null 2>&1 || true
}
trap restore_ntp_sampling EXIT HUP INT TERM

"$CHRONYC" -n manual on >/dev/null \
    || fail "chronyd rejected temporary manual-input enable"

TZ=UTC "$CHRONYC" -n settime "$TARGET" \
    || fail "chronyd rejected the UTC time sample"

restore_ntp_sampling
trap - EXIT HUP INT TERM

printf 'Clock sample accepted by chronyd: %s UTC\n' "$TARGET"
printf 'NTP sources returned online and burst sampling requested.\n'
