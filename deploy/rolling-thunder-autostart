#!/usr/bin/env bash
set -euo pipefail

readonly APP_DIR="${ROLLING_THUNDER_APP_DIR:-/home/geoff/projects/rolling-thunder-v4}"
readonly VENV_DIR="${ROLLING_THUNDER_VENV_DIR:-/home/geoff/projects/rolling-thunder-v4/.venv}"
readonly CONFIG_PATH="${ROLLING_THUNDER_CONFIG:-${APP_DIR}/config/rolling-thunder.yaml}"
readonly MIN_UPTIME_SECONDS="${ROLLING_THUNDER_MIN_UPTIME_SECONDS:-${ROLLING_THUNDER_STARTUP_DELAY_SECONDS:-180}}"
readonly UPTIME_PATH="${ROLLING_THUNDER_UPTIME_PATH:-/proc/uptime}"
readonly DISPLAY_VALUE="${DISPLAY:-:0}"
readonly XAUTHORITY_VALUE="${XAUTHORITY:-/home/geoff/.Xauthority}"
readonly LOCK_PATH="${ROLLING_THUNDER_INSTANCE_LOCK_PATH:-${XDG_RUNTIME_DIR:-/tmp}/rolling-thunder-ui-$(id -u).lock}"

log() {
    printf '%s rolling-thunder-autostart: %s\n' "$(date --iso-8601=seconds)" "$*"
}

dashboard_is_running() {
    pgrep -u "$(id -u)" -f \
        '[p]ython.*rolling_thunder\.ui_main|[r]olling-thunder-ui' \
        >/dev/null 2>&1
}

require_file() {
    local path="$1"
    local description="$2"
    if [[ ! -f "$path" ]]; then
        log "ERROR: ${description} not found: ${path}"
        exit 1
    fi
}

require_executable() {
    local path="$1"
    local description="$2"
    if [[ ! -x "$path" ]]; then
        log "ERROR: ${description} is not executable: ${path}"
        exit 1
    fi
}

system_uptime_seconds() {
    local raw_uptime
    local ignored

    if [[ ! -r "$UPTIME_PATH" ]]; then
        log "ERROR: system uptime source is not readable: ${UPTIME_PATH}"
        exit 1
    fi

    read -r raw_uptime ignored < "$UPTIME_PATH"
    raw_uptime="${raw_uptime%%.*}"

    if [[ ! "$raw_uptime" =~ ^[0-9]+$ ]]; then
        log "ERROR: invalid system uptime value from ${UPTIME_PATH}"
        exit 1
    fi

    printf '%s\n' "$raw_uptime"
}

if [[ ! "$MIN_UPTIME_SECONDS" =~ ^[0-9]+$ ]]; then
    log "ERROR: ROLLING_THUNDER_MIN_UPTIME_SECONDS must be a non-negative integer."
    exit 1
fi

# Kernel lock is inherited across exec by the UI process.
# Unlike pgrep, flock atomically serializes concurrent launch attempts.
require_executable /usr/bin/flock "flock instance guard"
if [[ -L "$LOCK_PATH" ]]; then
    log "ERROR: refusing symlink instance lock: $LOCK_PATH"
    exit 1
fi
exec 9>"$LOCK_PATH"
if ! /usr/bin/flock -n 9; then
    log "ERROR: another launcher or dashboard owns the instance lock"
    exit 1
fi

if dashboard_is_running; then
    log "ERROR: unmanaged dashboard already running; refusing false successful startup"
    exit 1
fi

UPTIME_SECONDS="$(system_uptime_seconds)"

if (( UPTIME_SECONDS < MIN_UPTIME_SECONDS )); then
    WAIT_SECONDS=$((MIN_UPTIME_SECONDS - UPTIME_SECONDS))
    log "system uptime is ${UPTIME_SECONDS}s; waiting ${WAIT_SECONDS}s until minimum uptime ${MIN_UPTIME_SECONDS}s"
    sleep "$WAIT_SECONDS"
else
    log "system uptime is ${UPTIME_SECONDS}s; minimum uptime ${MIN_UPTIME_SECONDS}s already satisfied"
fi

if dashboard_is_running; then
    log "ERROR: unmanaged dashboard started while waiting; refusing duplicate"
    exit 1
fi

require_file "${APP_DIR}/pyproject.toml" "Rolling Thunder production checkout"
require_executable "${VENV_DIR}/bin/rolling-thunder-ui" "Rolling Thunder UI entry point"
require_file "$CONFIG_PATH" "Rolling Thunder configuration"

export DISPLAY="$DISPLAY_VALUE"
if [[ -f "$XAUTHORITY_VALUE" ]]; then
    export XAUTHORITY="$XAUTHORITY_VALUE"
else
    log "WARNING: XAUTHORITY file not found at ${XAUTHORITY_VALUE}; continuing"
fi

cd "$APP_DIR"
log "starting dashboard from ${APP_DIR} with venv ${VENV_DIR} on DISPLAY=${DISPLAY}"
exec "${VENV_DIR}/bin/rolling-thunder-ui"
