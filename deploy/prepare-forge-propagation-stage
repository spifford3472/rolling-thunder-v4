#!/usr/bin/env bash
set -euo pipefail

# Build an unprivileged review artifact from one pushed origin commit. This tool
# never writes the root-owned production staging tree; the runbook promotes the
# reviewed bytes separately with explicit root-owned installation commands.

build_root=""
payload_root=""

usage() {
    echo "usage: $0 {dry-run|build} EXACT_40_CHARACTER_LOWERCASE_COMMIT_SHA OUTPUT_ROOT" >&2
}

die() {
    echo "ERROR: $*" >&2
    exit 2
}

cleanup_build_paths() {
    local -a paths=()

    [[ -z "${build_root}" ]] || paths+=("${build_root}")
    [[ -z "${payload_root}" ]] || paths+=("${payload_root}")
    (( ${#paths[@]} == 0 )) || rm -rf -- "${paths[@]}"
}

require_origin_commit() {
    local repo="$1"
    local sha="$2"
    local ref remote_ref=""

    git -C "${repo}" fetch origin
    git -C "${repo}" cat-file -e "${sha}^{commit}" 2>/dev/null || die \
        "commit is not present after fetching origin: ${sha}"
    while IFS= read -r ref; do
        if [[ "${ref}" != "refs/remotes/origin/HEAD" ]]; then
            remote_ref="${ref}"
            break
        fi
    done < <(git -C "${repo}" for-each-ref \
        --format='%(refname)' --contains "${sha}" refs/remotes/origin/)
    [[ -n "${remote_ref}" ]] || die \
        "commit is not contained in a fetched origin branch: ${sha}"
}

main() {
    (( $# == 3 )) || { usage; exit 2; }
    local action="$1"
    local sha="$2"
    local output_root="$3"
    local script_dir repo destination source_root
    local source_date_epoch

    [[ "${action}" == "dry-run" || "${action}" == "build" ]] || {
        usage
        exit 2
    }
    [[ "${sha}" =~ ^[0-9a-f]{40}$ ]] || die \
        "commit must be exactly 40 lowercase hexadecimal characters"
    (( EUID != 0 )) || die "run this preparation tool as an unprivileged account"
    script_dir="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
    repo="$(git -C "${script_dir}/.." rev-parse --show-toplevel)" || die \
        "tool must be run from a Git checkout"
    [[ -d "${output_root}" && ! -L "${output_root}" ]] || die \
        "OUTPUT_ROOT must be an existing non-symlink directory"
    output_root="$(CDPATH= cd -- "${output_root}" && pwd -P)"
    destination="${output_root}/${sha}"
    [[ ! -e "${destination}" && ! -L "${destination}" ]] || die \
        "refusing to replace existing artifact: ${destination}"

    require_origin_commit "${repo}" "${sha}"
    source_date_epoch="$(git -C "${repo}" show -s --format=%ct "${sha}")"

    if [[ "${action}" == "dry-run" ]]; then
        printf 'Verified pushed origin commit: %s\n' "${sha}"
        printf 'Would build exact Git archive into: %s\n' "${destination}"
        printf 'Would use SOURCE_DATE_EPOCH=%s and create wheelhouse/SHA256SUMS.\n' \
            "${source_date_epoch}"
        exit 0
    fi

    trap cleanup_build_paths EXIT
    build_root="$(mktemp -d)"
    payload_root="$(mktemp -d --tmpdir="${output_root}" .propagation-stage.XXXXXXXX)"
    source_root="${build_root}/source"
    mkdir -m 0700 "${source_root}"
    mkdir -m 0755 "${payload_root}/wheelhouse"

    git -C "${repo}" archive --format=tar "${sha}" | tar -xf - -C "${source_root}"
    SOURCE_DATE_EPOCH="${source_date_epoch}" python3 -m pip wheel \
        --disable-pip-version-check \
        --wheel-dir "${payload_root}/wheelhouse" \
        "${source_root}"
    printf '%s\n' "${sha}" > "${payload_root}/COMMIT_SHA"
    (
        cd "${payload_root}/wheelhouse"
        sha256sum -- *.whl > SHA256SUMS
        sha256sum --check --strict SHA256SUMS
    )
    mv -- "${payload_root}" "${destination}"
    payload_root=""
    printf 'Prepared unprivileged exact-commit artifact: %s\n' "${destination}"
    printf 'Review it before separately promoting it to the root-owned staging tree.\n'
}

main "$@"
